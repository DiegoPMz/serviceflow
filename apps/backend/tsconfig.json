{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"types": ["bun"],

		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		"jsx": "react-jsx",
		"jsxImportSource": "react",

		"baseUrl": ".",
		"paths": {
			"@serviceflow/backend/*": ["./src/*"]
		}
	}
}
