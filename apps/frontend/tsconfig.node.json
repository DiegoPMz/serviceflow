{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "ESNext",
		"lib": ["ESNext"],
		"types": ["node"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,

		// // Frontend aliases
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@serviceflow/backend/*": ["../backend/src/*"]
		}
	},

	"include": ["vite.config.ts"]
}
